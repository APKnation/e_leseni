# e-Leseni backend environment (template)
# Copy to .env and adjust per environment. NEVER commit the real .env.

# Django
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=*

# PostgreSQL
DB_NAME=leseni
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# SMS backend: console | database | dotted path to a custom backend
SMS_BACKEND=console
